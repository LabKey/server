    -->
    <suppress>
       <notes><![CDATA[
       file name: rhino-1.7R3.jar
       ]]></notes>
       <packageUrl regex="true">^pkg:maven/org\.mozilla/rhino@.*$</packageUrl>
       <vulnerabilityName>CVE-2025-66453</vulnerabilityName>
    </suppress>

