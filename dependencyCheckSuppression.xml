   file name: sanselan-0.97-incubator.jar
   ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.sanselan/sanselan@.*$</packageUrl>
        <vulnerabilityName>CVE-2018-17201</vulnerabilityName>
    </suppress>

